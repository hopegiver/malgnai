{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node bin/hook-scan.js || true"
          }
        ]
      }
    ]
  },
  "permissions": {
    "defaultMode": "bypassPermissions",
    "allow": [
      "Bash",
      "Grep",
      "Read",
      "Write(/private/tmp/*)",
      "Bash(/private/tmp/*)",
      "Bash(grep *)",
      "Bash(rg *)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(rm -r /*)",
      "Bash(del /f /s /q *)",
      "Bash(rd /s /q *)",
      "Bash(format *)",
      "Bash(mkfs*)"
    ],
    "additionalDirectories": [
      "/private/tmp",
      "/Users/hopegiver/.claude/projects",
      "/Users/hopegiver/workspace/malgnai"
    ]
  }
}

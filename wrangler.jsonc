{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "malgnai-hub",
  "main": "server/index.js",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],

  // `agents` 패키지가 AIChatAgent 경로에서 선택적으로 동적 import하는 "ai"(Vercel AI SDK)를
  // no-op 스텁으로 치환 — 이 프로젝트는 McpAgent를 순수 MCP 서버로만 쓰고 그 경로를 호출하지
  // 않는다(server/stubs/ai-noop.js 주석 참고). 미설치 상태에서 빌드가 깨지는 것만 막는 용도.
  "alias": {
    "ai": "./server/stubs/ai-noop.js"
  },

  "durable_objects": {
    "bindings": [
      { "name": "MCP_AGENT", "class_name": "MalgnMcpAgent" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["MalgnMcpAgent"] }
  ],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "malgnai-hub",
      "database_id": "03e447c3-7080-47ca-8b1e-876bba84e3ab",
      "migrations_dir": "./migrations"
    }
  ],

  // Google 로그인(/api/auth/google/*) 레이트리밋 — 보안점검 H1 처방(가장 적은 코드로 가장 큰
  // 효과, docs/security/google-oauth-login-review.md §2 H1). IP당 60초에 20회.
  //
  // ⚠️ namespace_id는 Worker 단위가 아니라 **계정 단위**로 스코프된다(Cloudflare 공식 문서,
  // developers.cloudflare.com/workers/runtime-apis/bindings/rate-limit/: "uniquely defines this
  // rate limiting namespace within your Cloudflare account" / 같은 namespace_id를 쓰는 두 바인딩은
  // "even across different Workers on the same account" 카운터를 공유한다). 그래서 이 값은 "임의로
  // 아무거나" 쓰면 안 되고, 이 계정에 등록된 다른 모든 Worker의 namespace_id와 겹치지 않는 이
  // Worker 전용 값이어야 한다 — 겹치면 다른 앱의 트래픽이 이 로그인을 막거나 그 반대가 된다(review
  // M-B, 2026-09-09). 리뷰가 잡아낸 이전 값 "1001"은 Cloudflare 공식 문서의 예제값을 그대로 복사한
  // 것이었다. 아래 값은 "malgnai-hub:google-login-rl"라는 이 바인딩 전용 문자열의 sha256 앞 10자
  // (16진수)를 10진수로 변환해 만든, 이 앱에 고유한 식별자다. 이 스니펫을 다른 앱에 복제할 때는
  // 반드시 그 앱 고유의 새 값으로 다시 만들 것(예: sha256("<앱이름>:<바인딩 용도>")로 동일하게 파생).
  // 사전에 별도로 생성해야 할 Cloudflare 리소스는 없다 — 이 값이 배포에 반영되는 것은 다음
  // `wrangler deploy`부터다(이번 라운드는 코드+설정만, deploy는 하지 않았다). server/api/
  // auth-google.js의 checkRateLimit()이 c.env.GOOGLE_LOGIN_RL 존재 여부로 가드하므로, 이 바인딩이
  // 아직 반영 전인 로컬/스테이징에서도 fail-open으로 정상 동작한다 — 그래서 배포 후 이 바인딩이
  // 실제로 붙었는지 배포 체크리스트로 반드시 확인할 것.
  // PLUGIN_DEPLOY_RL — claude-plugins CI 배포알림(POST /api/plugin-deploys/notify) 전용
  // 레이트리밋(docs/design/plugin-deploy-notify.md §9.2). 이 URL은 공개 저장소
  // malgnsoft/claude-plugins의 워크플로 YAML에 그대로 적혀 인터넷에 노출되고, 서버리스에서는
  // 인증 실패도 이미 과금된 뒤라는 이유로 넣는다(§9.1).
  //
  // ⚠️ namespace_id는 위 GOOGLE_LOGIN_RL 주석이 설명하는 대로 계정 전역 스코프다 — 기존 값
  // "873909047174"를 재사용하면 Google 로그인 트래픽과 배포 알림이 같은 카운터를 공유해 서로를
  // 막는다. 아래 값은 같은 파생 규칙("malgnai-hub:plugin-deploy-rl"의 sha256 앞 10자 hex를
  // 10진수로 변환)으로 만든 이 바인딩 전용 값이다 — 다른 앱/바인딩에 복제할 때는 반드시 그
  // 앱·바인딩 고유의 새 문자열로 다시 파생할 것.
  // malgnai-hub의 범용 이메일 발송(MCP 도구 email_send) — docs/design/email-send-tool.md.
  // 제품은 **Cloudflare Email Service의 Email Sending**이다(옛 Email Routing send_email 바인딩이
  // 여기로 통합됐다 — 옛 문서 URL이 email-service로 301 리다이렉트된다, 설계 §1.1).
  //
  // ⚠️ allowed_sender_addresses를 **반드시** 유지할 것. 이 도구는 사내 수신자에게 임의 본문을
  //    보낼 수 있으므로, 최소한 "어떤 명의로 나가는가"만은 코드 버그로도 못 바꾸게 Cloudflare
  //    쪽에서 고정한다(예: ppm-mcp의 report@apiserver.kr 사칭 차단). 이 배열을 지우면 같은
  //    계정의 온보딩된 도메인 어느 주소로든 발신이 가능해진다.
  // ⚠️ allowed_destination_addresses는 **설정하지 않는다** — 수신자 제한(D9)이 없어서가 아니라,
  //    이 속성이 **주소 단위 목록**이라 "@malgnsoft.com 도메인 전체"라는 규칙을 표현할 수 없기
  //    때문이다. 직원 주소를 일일이 나열하면 회사 명부의 두 번째 정본이 생겨 입·퇴사마다
  //    드리프트하고, 그 실패(E_RECIPIENT_NOT_ALLOWED)는 감사 INSERT가 끝난 뒤에 나므로
  //    "기록은 있는데 안 나간 건"을 양산한다. 수신자 제한은 발송 전 코드 게이트가 담당한다
  //    (설계 §6.4 — 완전일치 판정, RECIPIENT_DOMAIN_NOT_ALLOWED).
  // ⚠️ 이 주소 문자열은 server/lib/email.js의 FROM_ADDRESS 상수와 **반드시 같아야 한다**.
  //    한쪽만 바꾸면 E_VALIDATION_ERROR로 전건 실패한다. 바꿀 때 같이 볼 파일:
  //    wrangler.jsonc(이 줄) / server/lib/email.js(FROM_ADDRESS) / docs/design/email-send-tool.md §2.3
  // ⚠️ 이 바인딩이 실제로 동작하려면 apiserver.kr이 Cloudflare 대시보드에서 Email Sending
  //    발송 도메인으로 온보딩돼 있어야 하고 계정이 Workers Paid여야 한다(설계 §2.4 M-1·M-2,
  //    사람이 해야 하는 수동 단계 — 코드로 자동화 불가). 미완 상태면 도구가
  //    E_SENDER_DOMAIN_NOT_AVAILABLE로 실패한다.
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": ["malgnai@apiserver.kr"]
    }
  ],

  "ratelimits": [
    { "name": "GOOGLE_LOGIN_RL", "namespace_id": "873909047174", "simple": { "limit": 20, "period": 60 } },
    { "name": "PLUGIN_DEPLOY_RL", "namespace_id": "725107757322", "simple": { "limit": 10, "period": 60 } },
    // EMAIL_SEND_RL — MCP 도구 email_send 전용(설계 §4). 기존 두 바인딩과 **축이 다르다**:
    // 키가 IP가 아니라 userId다(인증된 사용자 단위 남용이 관심사이고, 사무실 NAT 뒤 공용 IP로
    // 잡으면 직원끼리 서로를 막는다 — plugin-deploys.js의 m-3 주석이 기록한 회귀).
    // 또 이 바인딩만 **fail-closed**다(바인딩 부재·오류 시 통과가 아니라 거부) — 로그인은 막히면
    // 서비스가 죽지만 이메일은 안 나가도 죽지 않는다. 그래서 server/api/*의 checkRateLimit()을
    // 재사용하지 말고 전용 함수를 쓴다(server/lib/email.js의 checkEmailRateLimit(), 설계 §4.5).
    //
    // ⚠️ namespace_id는 계정 전역 스코프다 — 위 두 값을 복사하면 로그인/배포알림/메일발송이
    // 카운터를 공유해 서로를 막는다. 아래 값은 동일 파생 규칙(sha256("malgnai-hub:email-send-rl")의
    // 앞 10자 hex → 10진수)으로 만든 이 바인딩 전용 값이다.
    // ⚠️ period는 10 또는 60만 허용된다(Cloudflare 공식) — 즉 이 바인딩만으로는 "하루 N건" 같은
    // 볼륨 상한을 만들 수 없다(5/60초 = 하루 7,200건까지 허용). 볼륨 축은 코드에서 audit_logs를
    // 세는 2층 상한(사용자당 24시간 50건)이 담당한다(설계 §4.3).
    { "name": "EMAIL_SEND_RL", "namespace_id": "177083697811", "simple": { "limit": 5, "period": 60 } }
  ],

  // app/(SPA)을 별도 Pages 배포 대신 Worker 정적 자산 바인딩으로 단일 배포(대표 지시,
  // architecture.md §1/§9.2의 별도 Pages안에서 벗어난 v1 결정 — decision_add로 기록).
  // /api/*·/mcp*·/.well-known/oauth-*·/sso는 정적 파일 매칭 여부와 무관하게 항상
  // Worker(server/index.js)로 먼저 라우팅하고, 나머지 경로는 정적 자산을 서빙하다가 매칭 실패 시
  // index.html로 폴백(SPA 클라이언트 라우팅).
  // ⚠️ '/sso' 항목은 server/index.js 최상위 디스패처의 url.pathname === '/sso' 분기,
  // server/api/sso.js의 registerSsoRoute() 등록과 3곳이 모두 일치해야 동작한다 — 한쪽만 바꾸면
  // 나머지는 그대로인 채 그 요청이 조용히 text/html 200(SPA 폴백)이 되고, 이를 잡아낼 테스트도 없다.
  "assets": {
    "directory": "./app",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/mcp*", "/.well-known/oauth-*", "/sso"]
  },

  "observability": {
    "enabled": true
  },

  // 사용량 통계의 상류 — 회사 OTel/Prometheus를 Grafana 데이터소스 프록시로 읽는다
  // (docs/architecture.md §0 결정29, docs/design/usage-prometheus-realtime.md).
  // 비밀이 아닌 값만 여기 둔다. GRAFANA_API_TOKEN은 `wrangler secret put`으로만 주입한다.
  //
  // ⚠️ 반드시 https + 호스트명이어야 한다. Cloudflare Workers는 raw IP로 아웃바운드 fetch를
  // 하지 못하고(엣지가 403 `error code: 1003`으로 반려), 프로덕션은 server/lib/prom-client.js의
  // validateUpstreamScheme()가 https가 아니면 상류로 나가지 않고 fail-closed한다.
  // 이 호스트는 Cloudflare DNS 프록시 + Origin Rule(목적지 포트 3000)로 오리진 Grafana에
  // 연결된다 — 구성 절차는 docs/runbook/grafana-cloudflare-dns-proxy.md.
  "vars": {
    "GRAFANA_BASE_URL": "https://otel.apiserver.kr",
    "GRAFANA_PROM_DATASOURCE_UID": "cftfxno3cwm4gd",
    // Google 로그인(docs/design/google-oauth-login.md §7.4·§9.2) — GOOGLE_CLIENT_ID/SECRET은
    // secret이라 여기 없다(wrangler secret put으로만 주입). §7.3 판정 결과 A(malgnsoft.com은
    // Google Workspace 도메인, 동의화면 Internal 확인됨) — GOOGLE_ALLOWED_EMAIL_DOMAIN(결과 B용
    // 대체 통제선)은 쓰지 않는다.
    "GOOGLE_REDIRECT_URI": "https://malgnai-hub.apiserver.kr/api/auth/google/callback",
    "GOOGLE_ALLOWED_HD": "malgnsoft.com"
  },

  // 로컬 dev 서버 고유 포트 — wrangler 기본값(8787)은 다른 프로젝트도 미지정 시 같이 쓰는
  // 값이라 동시 작업 중 포트 충돌·오인 kill 사고가 났음(2026-09-01). mycerti=8001,
  // malgnsales=8002, malgn-wiki=8003, performance=8790과 겹치지 않는 값으로 고정.
  "dev": {
    "port": 8004
  },

  // malgn-dev 카탈로그(agents/skills/knowledge) 1일 1회 자동 동기화 — server/index.js의
  // scheduled 핸들러가 server/lib/catalog-sync.js의 syncCatalog()를 호출한다. 매일 18:00 UTC
  // (KST 03:00) — 트래픽 낮은 새벽 시간대, GitHub 미인증 60req/h 한도와도 무관(하루 1회뿐).
  //
  // "0 1 * * *"는 사용량 Prometheus 롤업 캐시 적재(docs/design/usage-prometheus-realtime.md
  // §18.1·§11.1). KST 전환(docs/design/usage-kst-day-boundary.md §4, 2026-09-08) 이후 day_at 경계가
  // KST 자정(=UTC 15:00)이 되면서 두 회차의 주/보조 역할이 뒤바뀌었다 — 18:00 UTC(KST 03:00, KST
  // 자정 이후 +3h)가 이제 **주 적재**, 01:00 UTC(KST 10:00, +10h)가 **보조 재시도**다. 문자열 값
  // 자체는 바꾸지 않았다(스케줄 변경 없이 W1 불변식이 그대로 보존됨, §4 "단순함이 이긴다"). ⚠️ 이
  // 두 문자열은 server/index.js의 scheduled(controller,…) 분기 문자열과 공백까지 정확히 일치해야
  // 한다(Cloudflare 공식 요구 — 한쪽만 바꾸면 그 회차는 조용히 아무것도 하지 않는다).
  "triggers": {
    "crons": ["0 18 * * *", "0 1 * * *"]
  }
}

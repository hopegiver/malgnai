{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "malgnai-hub",
  "main": "server/index.js",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],

  // `agents` 패키지가 AIChatAgent 경로에서 선택적으로 동적 import하는 "ai"(Vercel AI SDK)를
  // no-op 스텁으로 치환 — 이 프로젝트는 McpAgent를 순수 MCP 서버로만 쓰고 그 경로를 호출하지
  // 않는다(server/stubs/ai-noop.js 주석 참고). 미설치 상태에서 빌드가 깨지는 것만 막는 용도.
  "alias": {
    "ai": "./server/stubs/ai-noop.js"
  },

  "durable_objects": {
    "bindings": [
      { "name": "MCP_AGENT", "class_name": "MalgnMcpAgent" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["MalgnMcpAgent"] }
  ],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "malgnai-hub",
      "database_id": "03e447c3-7080-47ca-8b1e-876bba84e3ab",
      "migrations_dir": "./migrations"
    }
  ],

  // app/(SPA)을 별도 Pages 배포 대신 Worker 정적 자산 바인딩으로 단일 배포(대표 지시,
  // architecture.md §1/§9.2의 별도 Pages안에서 벗어난 v1 결정 — decision_add로 기록).
  // /api/*·/mcp*는 정적 파일 매칭 여부와 무관하게 항상 Worker(server/index.js)로 먼저 라우팅하고,
  // 나머지 경로는 정적 자산을 서빙하다가 매칭 실패 시 index.html로 폴백(SPA 클라이언트 라우팅).
  "assets": {
    "directory": "./app",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/mcp*", "/.well-known/oauth-*"]
  },

  "observability": {
    "enabled": true
  },

  // 사용량 통계의 상류 — 회사 OTel/Prometheus를 Grafana 데이터소스 프록시로 읽는다
  // (docs/architecture.md §0 결정29, docs/design/usage-prometheus-realtime.md).
  // 비밀이 아닌 값만 여기 둔다. GRAFANA_API_TOKEN은 `wrangler secret put`으로만 주입한다.
  //
  // ⚠️ 반드시 https + 호스트명이어야 한다. Cloudflare Workers는 raw IP로 아웃바운드 fetch를
  // 하지 못하고(엣지가 403 `error code: 1003`으로 반려), 프로덕션은 server/lib/prom-client.js의
  // validateUpstreamScheme()가 https가 아니면 상류로 나가지 않고 fail-closed한다.
  // 이 호스트는 Cloudflare DNS 프록시 + Origin Rule(목적지 포트 3000)로 오리진 Grafana에
  // 연결된다 — 구성 절차는 docs/runbook/grafana-cloudflare-dns-proxy.md.
  "vars": {
    "GRAFANA_BASE_URL": "https://otel.apiserver.kr",
    "GRAFANA_PROM_DATASOURCE_UID": "cftfxno3cwm4gd"
  },

  // 로컬 dev 서버 고유 포트 — wrangler 기본값(8787)은 다른 프로젝트도 미지정 시 같이 쓰는
  // 값이라 동시 작업 중 포트 충돌·오인 kill 사고가 났음(2026-09-01). mycerti=8001,
  // malgnsales=8002, malgn-wiki=8003, performance=8790과 겹치지 않는 값으로 고정.
  "dev": {
    "port": 8004
  },

  // malgn-dev 카탈로그(agents/skills/knowledge) 1일 1회 자동 동기화 — server/index.js의
  // scheduled 핸들러가 server/lib/catalog-sync.js의 syncCatalog()를 호출한다. 매일 18:00 UTC
  // (KST 03:00) — 트래픽 낮은 새벽 시간대, GitHub 미인증 60req/h 한도와도 무관(하루 1회뿐).
  //
  // "0 1 * * *"는 사용량 Prometheus 롤업 캐시 적재(신규, docs/design/usage-prometheus-realtime.md
  // §18.1·§11.1) — 01:00 UTC 주 적재 + 기존 18:00 UTC 회차가 보조 재시도를 겸한다. ⚠️ 이 두
  // 문자열은 server/index.js의 scheduled(controller,…) 분기 문자열과 공백까지 정확히 일치해야
  // 한다(Cloudflare 공식 요구 — 한쪽만 바꾸면 그 회차는 조용히 아무것도 하지 않는다).
  "triggers": {
    "crons": ["0 18 * * *", "0 1 * * *"]
  }
}
